{
  "expo": {
    "name": "Selah",
    "slug": "selah-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.jpg",
    "scheme": "selah",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.selah.app"
    },
    "android": {
      "package": "com.selah.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#377333",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/app-icon.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/transparent-pixel.png",
          "imageWidth": 1,
          "resizeMode": "contain",
          "backgroundColor": "#FAF7F2",
          "dark": {
            "image": "./assets/images/transparent-pixel.png",
            "backgroundColor": "#14120E"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#377333"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9243b46e-1e22-48a2-aa40-4c45c1646a96"
      }
    },
    "owner": "dsadada"
  }
}
