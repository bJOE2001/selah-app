{
  "expo": {
    "name": "Shephema",
    "slug": "shephema-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shephema",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.shephema.app",
      "adaptiveIcon": {
        "backgroundColor": "#377333",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/mascot-holding-bible-transparent.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FBF9F5",
          "dark": {
            "image": "./assets/images/mascot-holding-bible-transparent.png",
            "backgroundColor": "#14120E"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#2D6A4F"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0010f319-b7c0-487b-a157-c31d903b8019"
      }
    }
  }
}
