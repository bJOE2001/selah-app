{
  "expo": {
    "name": "Selah",
    "slug": "selah-app",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.jpg",
    "scheme": "selah",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.selah.devotional",
      "buildNumber": "4"
    },
    "android": {
      "package": "com.selah.devotional",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#377333",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/app-icon.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/transparent-pixel.png",
          "imageWidth": 1,
          "resizeMode": "contain",
          "backgroundColor": "#FAF7F2",
          "dark": {
            "image": "./assets/images/transparent-pixel.png",
            "backgroundColor": "#14120E"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#377333"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "style": "auto",
          "enforceContrast": false
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-sharing",
      "expo-sqlite",
      "expo-status-bar",
      "expo-video",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "enforceContrast": false,
        "style": "auto"
      },
      "eas": {
        "projectId": "28b5a802-28aa-4a3e-8ce4-f144b3a94697"
      }
    },
    "owner": "bellyjoe12"
  }
}
