{
  "expo": {
    "name": "Shepema",
    "slug": "shepema-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.jpg",
    "scheme": "shepema",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.shepema.app",
      "adaptiveIcon": {
        "backgroundColor": "#377333",
        "foregroundImage": "./assets/images/app-icon.jpg",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/app-icon.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/transparent-pixel.png",
          "imageWidth": 1,
          "resizeMode": "contain",
          "backgroundColor": "#FAF7F2",
          "dark": {
            "image": "./assets/images/transparent-pixel.png",
            "backgroundColor": "#14120E"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#2D6A4F"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2061a430-c973-490a-9752-0c62e60c520f"
      }
    }
  }
}
